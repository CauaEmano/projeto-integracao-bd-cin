digraph esquema_estrela {
  graph [layout=neato, overlap=false, splines=polyline, bgcolor="white", pad="0.35", label="Zika/SINAN - cinco dimensões e uma fato\nDuas FKs de tempo: notificação e sintomas", labelloc=t, fontname="DejaVu Sans", fontsize=22];
  node [shape=plain, fontname="DejaVu Sans"];
  edge [color="#526579", arrowsize=0.7, fontname="DejaVu Sans", fontsize=10];
  dim_tempo [pos="0,6!", label=<<TABLE BORDER="1" COLOR="#cad6df" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#236b72" COLSPAN="2"><FONT COLOR="white"><B>dim_tempo</B></FONT></TD></TR><TR><TD PORT="sk_tempo" ALIGN="LEFT">PK sk_tempo</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD PORT="data_completa" ALIGN="LEFT">data_completa</TD><TD ALIGN="LEFT">DATE</TD></TR><TR><TD PORT="ano" ALIGN="LEFT">ano</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD PORT="mes" ALIGN="LEFT">mes</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD PORT="nome_mes" ALIGN="LEFT">nome_mes</TD><TD ALIGN="LEFT">VARCHAR(20)</TD></TR><TR><TD PORT="trimestre" ALIGN="LEFT">trimestre</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD PORT="semana_epidemiologica" ALIGN="LEFT">semana_epidemiologica</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD PORT="periodo_sazonal" ALIGN="LEFT">periodo_sazonal</TD><TD ALIGN="LEFT">VARCHAR(40)</TD></TR></TABLE>>];
  dim_localidade [pos="-7,1!", label=<<TABLE BORDER="1" COLOR="#cad6df" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#236b72" COLSPAN="2"><FONT COLOR="white"><B>dim_localidade</B></FONT></TD></TR><TR><TD PORT="sk_localidade" ALIGN="LEFT">PK sk_localidade</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD PORT="cod_uf_ibge" ALIGN="LEFT">cod_uf_ibge</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD PORT="sigla_uf" ALIGN="LEFT">sigla_uf</TD><TD ALIGN="LEFT">CHAR(2)</TD></TR><TR><TD PORT="nome_estado" ALIGN="LEFT">nome_estado</TD><TD ALIGN="LEFT">VARCHAR(50)</TD></TR><TR><TD PORT="regiao_brasil" ALIGN="LEFT">regiao_brasil</TD><TD ALIGN="LEFT">VARCHAR(20)</TD></TR><TR><TD PORT="cod_municipio_ibge6" ALIGN="LEFT">cod_municipio_ibge6</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD PORT="cod_regional_saude" ALIGN="LEFT">cod_regional_saude</TD><TD ALIGN="LEFT">INT</TD></TR></TABLE>>];
  dim_unidade_notificadora [pos="7,1!", label=<<TABLE BORDER="1" COLOR="#cad6df" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#236b72" COLSPAN="2"><FONT COLOR="white"><B>dim_unidade_notificadora</B></FONT></TD></TR><TR><TD PORT="sk_unidade" ALIGN="LEFT">PK sk_unidade</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD PORT="cod_unidade_cnes" ALIGN="LEFT">cod_unidade_cnes</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD PORT="cod_uf_notificacao" ALIGN="LEFT">cod_uf_notificacao</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD PORT="sigla_uf_notificacao" ALIGN="LEFT">sigla_uf_notificacao</TD><TD ALIGN="LEFT">CHAR(2)</TD></TR><TR><TD PORT="cod_municipio_notificacao" ALIGN="LEFT">cod_municipio_notificacao</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD PORT="cod_regional_notificacao" ALIGN="LEFT">cod_regional_notificacao</TD><TD ALIGN="LEFT">INT</TD></TR></TABLE>>];
  dim_paciente [pos="-6,-5!", label=<<TABLE BORDER="1" COLOR="#cad6df" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#236b72" COLSPAN="2"><FONT COLOR="white"><B>dim_paciente</B></FONT></TD></TR><TR><TD PORT="sk_paciente" ALIGN="LEFT">PK sk_paciente</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD PORT="sexo" ALIGN="LEFT">sexo</TD><TD ALIGN="LEFT">CHAR(1)</TD></TR><TR><TD PORT="descricao_sexo" ALIGN="LEFT">descricao_sexo</TD><TD ALIGN="LEFT">VARCHAR(20)</TD></TR><TR><TD PORT="idade_anos" ALIGN="LEFT">idade_anos</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD PORT="faixa_etaria" ALIGN="LEFT">faixa_etaria</TD><TD ALIGN="LEFT">VARCHAR(30)</TD></TR><TR><TD PORT="raca_cor" ALIGN="LEFT">raca_cor</TD><TD ALIGN="LEFT">VARCHAR(30)</TD></TR><TR><TD PORT="status_gestante" ALIGN="LEFT">status_gestante</TD><TD ALIGN="LEFT">VARCHAR(40)</TD></TR><TR><TD PORT="escolaridade" ALIGN="LEFT">escolaridade</TD><TD ALIGN="LEFT">VARCHAR(50)</TD></TR></TABLE>>];
  dim_investigacao_desfecho [pos="6,-5!", label=<<TABLE BORDER="1" COLOR="#cad6df" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#236b72" COLSPAN="2"><FONT COLOR="white"><B>dim_investigacao_desfecho</B></FONT></TD></TR><TR><TD PORT="sk_desfecho" ALIGN="LEFT">PK sk_desfecho</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD PORT="classificacao_final" ALIGN="LEFT">classificacao_final</TD><TD ALIGN="LEFT">VARCHAR(45)</TD></TR><TR><TD PORT="criterio_confirmacao" ALIGN="LEFT">criterio_confirmacao</TD><TD ALIGN="LEFT">VARCHAR(45)</TD></TR><TR><TD PORT="evolucao_caso" ALIGN="LEFT">evolucao_caso</TD><TD ALIGN="LEFT">VARCHAR(45)</TD></TR><TR><TD PORT="tipo_autoctonia" ALIGN="LEFT">tipo_autoctonia</TD><TD ALIGN="LEFT">VARCHAR(40)</TD></TR><TR><TD PORT="doenca_trabalho" ALIGN="LEFT">doenca_trabalho</TD><TD ALIGN="LEFT">VARCHAR(30)</TD></TR></TABLE>>];
  fato_notificacao_zika [pos="0,0!", label=<<TABLE BORDER="1" COLOR="#cad6df" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#124559" COLSPAN="2"><FONT COLOR="white"><B>fato_notificacao_zika</B></FONT></TD></TR><TR><TD PORT="sk_notificacao" ALIGN="LEFT">PK sk_notificacao</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD PORT="fk_tempo_notificacao" ALIGN="LEFT">FK fk_tempo_notificacao</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD PORT="fk_tempo_sintomas" ALIGN="LEFT">FK fk_tempo_sintomas</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD PORT="fk_localidade_residencia" ALIGN="LEFT">FK fk_localidade_residencia</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD PORT="fk_unidade_notificadora" ALIGN="LEFT">FK fk_unidade_notificadora</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD PORT="fk_paciente" ALIGN="LEFT">FK fk_paciente</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD PORT="fk_desfecho" ALIGN="LEFT">FK fk_desfecho</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD PORT="qt_notificacoes" ALIGN="LEFT">qt_notificacoes</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD PORT="fl_confirmado" ALIGN="LEFT">fl_confirmado</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD PORT="fl_descartado" ALIGN="LEFT">fl_descartado</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD PORT="fl_gestante" ALIGN="LEFT">fl_gestante</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD PORT="fl_obito_zika" ALIGN="LEFT">fl_obito_zika</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD PORT="qt_dias_atraso_notif" ALIGN="LEFT">qt_dias_atraso_notif</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD PORT="qt_dias_encerramento" ALIGN="LEFT">qt_dias_encerramento</TD><TD ALIGN="LEFT">INT</TD></TR></TABLE>>];
  fato_notificacao_zika:fk_tempo_notificacao -> dim_tempo:sk_tempo [tooltip="fk_tempo_notificacao: muitas linhas da fato para uma dimensão"];
  fato_notificacao_zika:fk_tempo_sintomas -> dim_tempo:sk_tempo [tooltip="fk_tempo_sintomas: muitas linhas da fato para uma dimensão"];
  fato_notificacao_zika:fk_localidade_residencia -> dim_localidade:sk_localidade [tooltip="fk_localidade_residencia: muitas linhas da fato para uma dimensão"];
  fato_notificacao_zika:fk_unidade_notificadora -> dim_unidade_notificadora:sk_unidade [tooltip="fk_unidade_notificadora: muitas linhas da fato para uma dimensão"];
  fato_notificacao_zika:fk_paciente -> dim_paciente:sk_paciente [tooltip="fk_paciente: muitas linhas da fato para uma dimensão"];
  fato_notificacao_zika:fk_desfecho -> dim_investigacao_desfecho:sk_desfecho [tooltip="fk_desfecho: muitas linhas da fato para uma dimensão"];
}
